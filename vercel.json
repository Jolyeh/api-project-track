{
    "version": 2,
    "name": "api project-track",
    "builds": [
        {
            "src": "src/server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "dist/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "src/(.*)",
            "dest": "src/server.js"
        }
    ]
}